{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{js,mjs,ts}"],
      "project": ["scripts/**/*.{js,mjs,ts}"]
    },
    "packages/permit2-rpc-server": {
      "entry": ["src/index.ts", "src/deno-server.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/permit2-rpc-client": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["bun-types"]
    }
  },
  "ignore": ["lib/**", "tmp/**", "node_modules/**"]
}
